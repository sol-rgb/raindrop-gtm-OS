# The config contract. Every variable the OS reads, with what it is for.
# Copy to .env.local for local work; in production these live in the Railway
# (or Vercel) project and in the GitHub repository secrets for the sync.

# Supabase Postgres, session pooler URI (Connect > Session pooler).
DATABASE_URL=

# Instantly API v2 key, scope all:read.
INSTANTLY_API_KEY=

# One HeyReach key per sender workspace. The suffix becomes the sender name.
HEYREACH_API_KEY_ZUBIN=
HEYREACH_API_KEY_MICHAEL=

# HubSpot Service Key: crm.objects.contacts.read, crm.objects.companies.read,
# crm.objects.deals.read.
HUBSPOT_SERVICE_KEY=

# Shared secrets for the two things that write in from outside. Any long
# random string; the endpoints refuse everything while these are empty.
CLAY_INGEST_SECRET=
WEBHOOK_SECRET=

# The shared team password on every page.
SITE_PASSWORD=

# The plan. Defaults shown.
GOAL_MEETINGS_PER_WEEK=15
ESTIMATED_ACV=25000
REPLY_SLA_HOURS=4
